# ============================================================
# LLM
# ============================================================
# Si no defines LLM_MODEL se usa el mock local (sin API key).
# Ejemplos:
#   Anthropic:  LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-4-6
#   OpenAI:     LLM_PROVIDER=openai     LLM_MODEL=gpt-4o
#   Google:     LLM_PROVIDER=google_genai LLM_MODEL=gemini-2.5-pro
#   Ollama:     LLM_PROVIDER=ollama     LLM_MODEL=llama3.1
#   Mock:       USE_MOCK_LLM=true

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# LLM_TEMPERATURE=0

# URL para proveedores locales o compatibles con OpenAI
# (Ollama, LM Studio, vLLM, etc.).
# LLM_BASE_URL=http://localhost:11434

# Fuerza el mock aunque haya un modelo configurado.
# USE_MOCK_LLM=false

# ============================================================
# API KEYS
# ============================================================
# Anthropic
ANTHROPIC_API_KEY=your-api-key

# OpenAI
# OPENAI_API_KEY=sk-...

# Google
# GOOGLE_API_KEY=...

# Ollama local normalmente no necesita API key.
# OPENAI_API_KEY=dummy  # solo si el proveedor compatible lo exige

# ============================================================
# DELAYS (segundos)
# ============================================================
# MOCK_LLM_DELAY=1.5
# TOOL_DELAY=0.6
# NODE_DELAY=0.5

# ============================================================
# LangSmith (opcional, requiere internet)
# ============================================================
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=langraph-demo
